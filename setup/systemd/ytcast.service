[Unit]
Description=YouTube Music yayin alicisi (Pi Panel)
After=network-online.target bluealsa.service
Wants=network-online.target

[Service]
User=pi
Group=pi
SupplementaryGroups=audio
WorkingDirectory=/home/pi/ytcast
RuntimeDirectory=ytcast
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/node /home/pi/ytcast/receiver.mjs
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
